---
import Base from '../layouts/Base.astro';
import Sidebar from './Sidebar.astro';
import PostCard from './PostCard.astro';
import Pagination from './Pagination.astro';
interface Props { title: string; crumbs: { label: string; href?: string }[]; page: any; base: string; intro?: string; hideTitle?: boolean }
const { title, crumbs, page, base, intro, hideTitle = false } = Astro.props;
---
<Base title={title} pageTitle={title} crumbs={crumbs}>
  <div class="wrap layout">
    <div class="primary">
      {!hideTitle && <h1 class="list-title">{title}</h1>}
      {intro && <p class="intro">{intro}</p>}
      <div class="cards">{page.data.map((a: any) => <PostCard article={a} />)}</div>
      <Pagination page={page} base={base} />
    </div>
    <Sidebar />
  </div>
</Base>
