---
// The IT4IT Atlas: a directory of IT management tools, business applications and platforms.
// The tools come from public/atlas/tools.json and the counts from src/data/atlas-meta.json, both made by
// scripts/build-atlas.mjs from atlas/IT4IT-Atlas.xlsx; the categories are in src/data/atlas-taxonomy.json.
// Filtering, search, paging and the Excel export run in the browser; the filters are kept in the address
// (?view=it4it&stream=Deploy&domain=service-delivery&sub=it-service-itsm&q=...; view=gartner is the Gartner Magic Quadrant tab), so a filtered list can be shared as a link.
import TAXONOMY from '../data/atlas-taxonomy.json';
import META from '../data/atlas-meta.json';
import { locale, url, type Lang } from '../i18n';
import { ATLAS_TEXT } from '../data/atlas-text';

const { lang } = Astro.props as { lang: Lang };

const TEXT = ATLAS_TEXT[lang];

const STREAMS = ['Evaluate', 'Explore', 'Integrate', 'Deploy', 'Release', 'Consume', 'Operate'];
const nf = new Intl.NumberFormat(locale[lang]);
const counts = META.counts as Record<string, number>;
const views = META.views as Record<string, number>;
const subTotal = TAXONOMY.sections.reduce((n, s) => n + s.groups.reduce((m, g) => m + g.subs.length, 0), 0);
// The last weekly update (scripts/maintain-atlas.mjs), else the latest check of a description.
const updated = new Date((META.activity as { date: string }[])[0]?.date ?? META.checked).toLocaleDateString(locale[lang], { day: 'numeric', month: 'long', year: 'numeric' });
// What the script in the browser needs: the categories and the texts that it fills in.
const config = {
  lang: locale[lang],
  sections: TAXONOMY.sections.map((s) => ({ id: s.id, name: s.name, groups: s.groups.map((g) => ({ name: g.name, subs: g.subs.map((x) => ({ id: x.id, name: x.name })) })) })),
  streams: STREAMS,
  domains: TAXONOMY.csdmDomains.map((d) => ({ id: d.id, name: d.name, desc: d.desc })),
  text: { profile: TEXT.profile, capabilities: TEXT.capabilities, labels: TEXT.labels, gartnerHead: TEXT.gartnerHead, report: TEXT.report, sourceHead: TEXT.sourceHead, checkedOn: TEXT.checkedOn, fromProducer: TEXT.fromProducer, fromThird: TEXT.fromThird, website: TEXT.website, close: TEXT.close, streamsLabel: TEXT.streamsLabel, allStreams: TEXT.allStreams, csdmLabel: TEXT.csdmLabel, allDomains: TEXT.allDomains, all: TEXT.all, allCaps: TEXT.allCaps, results: TEXT.results('{n}'), none: TEXT.none, reset: TEXT.reset, producer: TEXT.producer, source: TEXT.source, error: TEXT.error, prev: TEXT.prev, next: TEXT.next, page: TEXT.page, mq: TEXT.mq, mqTitle: TEXT.mqTitle, updatedOn: TEXT.updatedOn },
};
---
<div class="atlas" id="atlas">
  <div class="prose atlas-updated"><p set:html={TEXT.updated(updated).replace('{changes}', url(lang, '/it4it-atlas/changes/'))} /></div>
  <div class="atlas-stats">
    <div><b>{nf.format(META.tools)}</b><span>{TEXT.tools}</span></div>
    <div><b>{TAXONOMY.sections.length}</b><span>{TEXT.sections}</span></div>
    <div><b>{subTotal}</b><span>{TEXT.subcategories}</span></div>
    <div><b>{nf.format(META.gartner)}</b><span>{TEXT.gartner}</span></div>
  </div>

  <div class="atlas-tabbar">
  <div class="atlas-tabs" role="tablist">
    <button type="button" role="tab" data-view="" aria-selected="true">{TEXT.all} <small>{nf.format(META.tools)}</small></button>
    {TAXONOMY.sections.map((s) => <button type="button" role="tab" data-view={s.id} aria-selected="false">{s.name} <small>{nf.format(views[s.id] ?? 0)}</small></button>)}
    <button type="button" role="tab" data-view="gartner" aria-selected="false">{TEXT.mqTab} <small>{nf.format(META.gartner)}</small></button>
  </div>
  <span id="atlas-count" class="atlas-count" role="status"></span>
  </div>

  <div class="atlas-body">
    <div class="atlas-side">
      <details id="atlas-streams-box" open>
        <summary>{TEXT.streamsLabel}</summary>
        <nav id="atlas-streams"></nav>
      </details>
      <details open>
        <summary>{TEXT.csdmLabel}</summary>
        <nav id="atlas-domains"></nav>
      </details>
      <details open>
        <summary>{TEXT.browse}</summary>
        <nav id="atlas-caps"></nav>
      </details>
    </div>
    <div class="atlas-main">
      <div class="atlas-controls">
        <input type="search" id="atlas-q" placeholder={TEXT.search} aria-label={TEXT.search} />
        <select id="atlas-sort" aria-label="Sort">
          <option value="az">{TEXT.sortAZ}</option>
          <option value="za">{TEXT.sortZA}</option>
          <option value="vendor">{TEXT.sortVendor}</option>
          <option value="new">{TEXT.sortNew}</option>
          <option value="old">{TEXT.sortOld}</option>
        </select>
        <button type="button" class="atlas-export" id="atlas-export" disabled>{TEXT.export}</button>
      </div>
      <div id="atlas-list" class="atlas-list" aria-live="polite"><p class="muted">{TEXT.loading}</p></div>
      <nav id="atlas-pages" class="atlas-pages" aria-label={TEXT.page}></nav>
    </div>
  </div>

  <p class="atlas-note">{TEXT.note}</p>

  <dialog id="atlas-dialog" class="atlas-dialog" aria-labelledby="atlas-dialog-title"></dialog>
  <script type="application/json" id="atlas-config" is:inline set:html={JSON.stringify(config)}></script>
</div>

<script>
  import { xlsx } from '../scripts/xlsx';

  type Tool = { id: string; name: string; vendor: string; url: string; source: string; checked: string; description: string; descSource?: string; note?: string; logo?: string; subs: string[]; tags: string[]; views: string[]; streams: string[]; domains: string[]; gartner: { market: string; vendor: string; year: number; url: string }[] };
  const root = document.getElementById('atlas')!;
  const cfg = JSON.parse(document.getElementById('atlas-config')!.textContent!);
  const T = cfg.text;
  const PER_PAGE = 30;
  const $ = (id: string) => document.getElementById(id) as any;
  const esc = (s: string) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const nf = new Intl.NumberFormat(cfg.lang);

  // CSDM 5 domain id → its name.
  const DOMAIN: Record<string, string> = Object.fromEntries(cfg.domains.map((d: any) => [d.id, d.name]));
  // Subcategory id → its name, group and section.
  const SUB: Record<string, { name: string; group: string; section: string }> = {};
  for (const s of cfg.sections) for (const g of s.groups) for (const x of g.subs) SUB[x.id] = { name: x.name, group: g.name, section: s.id };

  const state = { view: '', group: '', sub: '', q: '', sort: 'az', stream: '', domain: '', page: 1 };
  let tools: Tool[] = [];

  function readUrl() {
    const p = new URLSearchParams(location.search);
    Object.assign(state, {
      view: p.get('view') ?? '', group: p.get('group') ?? '', sub: p.get('sub') ?? '', q: p.get('q') ?? '',
      sort: p.get('sort') ?? 'az', stream: p.get('stream') ?? '', domain: p.get('domain') ?? '', page: Math.max(1, +(p.get('page') ?? 1) || 1),
    });
    if (p.get('mq') === '1') state.view = 'gartner'; // links from before the Gartner tab
    if (state.view === 'workplace') state.view = 'business'; // workplace platforms are part of business applications now
  }
  function writeUrl() {
    const p = new URLSearchParams();
    if (state.view) p.set('view', state.view);
    if (state.group) p.set('group', state.group);
    if (state.sub) p.set('sub', state.sub);
    if (state.q) p.set('q', state.q);
    if (state.sort !== 'az') p.set('sort', state.sort);
    if (state.stream) p.set('stream', state.stream);
    if (state.domain) p.set('domain', state.domain);
    if (state.page > 1) p.set('page', String(state.page));
    const qs = p.toString();
    history.replaceState(null, '', location.pathname + (qs ? '?' + qs : '') + location.hash);
  }

  // The chosen section; the tabs "All tools" and "Gartner Magic Quadrant Tools" cover all sections.
  const section = () => (state.view === 'gartner' ? '' : state.view);
  // Subcategories that count for the chosen section (all of them for "All tools").
  const subsInView = (t: Tool) => (section() ? t.subs.filter((s) => SUB[s]?.section === section()) : t.subs);

  // Everything except the capability filter, so the sidebar can show how many tools each capability has
  // (and without the value stream or CSDM domain filter for the counts of those sections).
  function baseFilter(skip: '' | 'stream' | 'domain' = '') {
    const words = state.q.toLowerCase().split(/\s+/).filter(Boolean);
    return tools.filter((t) => {
      if (section() && !t.views.includes(section())) return false;
      if (state.view === 'gartner' && !t.gartner.length) return false;
      if (skip !== 'stream' && state.stream && !t.streams.includes(state.stream)) return false;
      if (skip !== 'domain' && state.domain && !t.domains.includes(state.domain)) return false;
      if (words.length) {
        const hay = `${t.name} ${t.vendor} ${t.description} ${t.tags.join(' ')} ${t.subs.map((s) => SUB[s]?.name).join(' ')}`.toLowerCase();
        if (!words.every((w) => hay.includes(w))) return false;
      }
      return true;
    });
  }

  function render() {
    root.querySelectorAll<HTMLElement>('.atlas-tabs [data-view]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.view === state.view)));
    $('atlas-q').value = state.q;
    $('atlas-sort').value = state.sort;

    // Sidebar, value streams: same layout as the capabilities, hidden where no tool has a value stream.
    const all = baseFilter('stream');
    const streamCount: Record<string, number> = {};
    for (const t of all) for (const s of t.streams) streamCount[s] = (streamCount[s] ?? 0) + 1;
    const withStreams = all.filter((t) => t.streams.length).length;
    $('atlas-streams-box').hidden = !withStreams && !state.stream;
    $('atlas-streams').innerHTML = `<a href="#" data-stream="" class="${!state.stream ? 'on' : ''}">${esc(T.allStreams)} <small>${nf.format(all.length)}</small></a>`
      + cfg.streams.map((s: string) => `<a href="#" data-stream="${esc(s)}" class="${state.stream === s ? 'on' : ''}">${esc(s)} <small>${nf.format(streamCount[s] ?? 0)}</small></a>`).join('');

    // Sidebar, CSDM 5 domains: the same again.
    const inDomains = baseFilter('domain');
    const domainCount: Record<string, number> = {};
    for (const t of inDomains) for (const d of t.domains) domainCount[d] = (domainCount[d] ?? 0) + 1;
    $('atlas-domains').innerHTML = `<a href="#" data-domain="" class="${!state.domain ? 'on' : ''}">${esc(T.allDomains)} <small>${nf.format(inDomains.length)}</small></a>`
      + cfg.domains.map((d: any) => `<a href="#" data-domain="${d.id}" title="${esc(d.desc)}" class="${state.domain === d.id ? 'on' : ''}">${esc(d.name)} <small>${nf.format(domainCount[d.id] ?? 0)}</small></a>`).join('');

    const base = baseFilter();
    // Sidebar: groups and subcategories of the chosen section(s), with counts.
    const subCount: Record<string, number> = {};
    const groupCount: Record<string, number> = {};
    for (const t of base) {
      const subs = subsInView(t);
      for (const s of subs) subCount[s] = (subCount[s] ?? 0) + 1;
      for (const g of new Set(subs.map((s) => SUB[s]?.group))) if (g) groupCount[g] = (groupCount[g] ?? 0) + 1;
    }
    const sections = cfg.sections.filter((s: any) => !section() || s.id === section());
    let nav = `<a href="#" data-group="" data-sub="" class="${!state.group && !state.sub ? 'on' : ''}">${esc(T.allCaps)} <small>${nf.format(base.length)}</small></a>`;
    for (const s of sections) {
      if (!section()) nav += `<h4>${esc(s.name)}</h4>`;
      for (const g of s.groups) {
        const open = state.group === g.name || g.subs.some((x: any) => x.id === state.sub);
        nav += `<div class="grp"><a href="#" data-group="${esc(g.name)}" data-sub="" class="parent ${state.group === g.name && !state.sub ? 'on' : ''}">${esc(g.name)} <small>${nf.format(groupCount[g.name] ?? 0)}</small></a>`;
        if (open && g.subs.length > 1) nav += g.subs.map((x: any) => `<a href="#" class="sub ${state.sub === x.id ? 'on' : ''}" data-group="${esc(g.name)}" data-sub="${x.id}">${esc(x.name)} <small>${nf.format(subCount[x.id] ?? 0)}</small></a>`).join('');
        nav += '</div>';
      }
    }
    $('atlas-caps').innerHTML = nav;

    // The list itself.
    let list = base.filter((t) => {
      if (state.sub) return t.subs.includes(state.sub);
      if (state.group) return subsInView(t).some((s) => SUB[s]?.group === state.group);
      return true;
    });
    const cmp = (a: string, b: string) => a.localeCompare(b, 'en', { sensitivity: 'base' });
    if (state.sort === 'za') list = [...list].reverse();
    if (state.sort === 'vendor') list = [...list].sort((a, b) => cmp(a.vendor, b.vendor) || cmp(a.name, b.name));
    // By the date a tool's description was last checked (tools without one last), then by name.
    if (state.sort === 'new') list = [...list].sort((a, b) => (b.checked ?? '').localeCompare(a.checked ?? '') || cmp(a.name, b.name));
    if (state.sort === 'old') list = [...list].sort((a, b) => (a.checked || '9').localeCompare(b.checked || '9') || cmp(a.name, b.name));
    current = list;

    const pages = Math.max(1, Math.ceil(list.length / PER_PAGE));
    if (state.page > pages) state.page = pages;
    $('atlas-count').textContent = T.results.replace('{n}', nf.format(list.length));
    $('atlas-export').disabled = !list.length;
    const shown = list.slice((state.page - 1) * PER_PAGE, state.page * PER_PAGE);
    $('atlas-list').innerHTML = shown.length ? shown.map(card).join('') : `<p>${esc(T.none)} <a href="#" id="atlas-reset">${esc(T.reset)}</a></p>`;
    $('atlas-pages').innerHTML = pages > 1 ? pager(pages) : '';
    writeUrl();
  }
  let current: Tool[] = [];

  // A date in short form, e.g. "28 Oct 2026".
  const short = (d: string) => { const x = new Date(d); return isNaN(+x) ? d : x.toLocaleDateString(cfg.lang, { day: 'numeric', month: 'short', year: 'numeric' }); };
  function host(u: string) { try { return new URL(u).hostname; } catch { return ''; } }
  function card(t: Tool) {
    const subs = subsInView(t);
    const first = SUB[subs[0]];
    const mq = t.gartner.length ? `<span class="mq" title="${esc(T.mqTitle + ' ' + t.gartner.map((g) => g.market).join('; '))}">${esc(T.mq)}</span>` : '';
    const tags = subs.slice(0, 2).map((s) => `<span class="tag">${esc(SUB[s]?.name ?? s)}</span>`).join('') + (subs.length > 2 ? `<span class="tag more">+${subs.length - 2}</span>` : '');
    return `<article class="atlas-card">
      ${logo(t)}
      <div class="body">
        <div class="cap">${esc(first?.group ?? '')}</div>
        <h3><button type="button" data-tool="${esc(t.id)}">${esc(t.name)}</button></h3>
        <div class="vendor">${esc(t.vendor)}</div>
        <p>${esc(t.description)}</p>
        <div class="csdm">${t.domains.map((d) => `<span title="CSDM 5">${esc(DOMAIN[d] ?? d)}</span>`).join('')}</div>
        <div class="tags">${tags}${mq}</div>
        <div class="links">${t.url ? `<a href="${esc(t.url)}" target="_blank" rel="noopener nofollow">${esc(T.producer)} ↗</a>` : ''}${t.source && t.source !== t.url ? `<a href="${esc(t.source)}" target="_blank" rel="noopener nofollow">${esc(T.source)} ↗</a>` : ''}${t.checked ? `<span class="date" title="${esc(T.updatedOn + ' ' + short(t.checked))}">↻ ${esc(short(t.checked))}</span>` : ''}</div>
      </div>
    </article>`;
  }

  // Logo: the one from the original Atlas, else the favicon of the product site, else of the producer site,
  // else the initials (the next candidate is tried when an image fails to load, see the error listener).
  function logo(t: Tool) {
    const initials = esc(t.name.replace(/[^A-Za-z0-9 ]/g, '').split(' ').filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase() || '•');
    const site = (u: string) => { try { const x = new URL(u); return x.protocol === 'https:' ? x.origin + '/favicon.ico' : ''; } catch { return ''; } };
    const blocked = /(^|\.)aimsinnovation\.com$/; // icon flagged by security software in the original Atlas
    const candidates = [t.logo, t.descSource === 'producer' && host(t.source) !== host(t.url) ? site(t.source) : '', site(t.url)]
      .filter((u): u is string => !!u && !blocked.test(host(u)))
      .filter((u, i, a) => a.indexOf(u) === i);
    const [first, ...rest] = candidates;
    return `<div class="logo"><span>${initials}</span>${first ? `<img src="${esc(first)}" data-next="${esc(rest.join(' '))}" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer">` : ''}</div>`;
  }

  function profile(t: Tool) {
    const subs = t.subs.filter((s) => SUB[s]);
    const date = (d: string) => { const x = new Date(d); return isNaN(+x) ? d : x.toLocaleDateString(cfg.lang, { day: 'numeric', month: 'long', year: 'numeric' }); };
    const link = (u: string, label: string) => `<a href="${esc(u)}" target="_blank" rel="noopener nofollow">${esc(label)} ↗</a>`;
    let html = `<form method="dialog"><button class="close" aria-label="${esc(T.close)}">×</button></form>
      <div class="head">${logo(t)}<div><div class="cap">${esc(T.profile)}</div><h2 id="atlas-dialog-title">${esc(t.name)}</h2><div class="vendor">${esc(t.vendor)}</div></div></div>
      <p>${esc(t.description)}</p>`;
    html += `<h3>${esc(T.capabilities)}</h3><ul>${subs.map((s) => `<li>${esc(SUB[s].group)} › <b>${esc(SUB[s].name)}</b></li>`).join('')}</ul>`;
    if (t.tags.length) html += `<h3>${esc(T.labels)}</h3><div class="tags">${t.tags.map((x) => `<span class="tag">${esc(x)}</span>`).join('')}</div>`;
    if (t.domains.length) html += `<h3>${esc(T.csdmLabel)}</h3><div class="tags">${t.domains.map((x) => `<span class="tag">${esc(DOMAIN[x] ?? x)}</span>`).join('')}</div>`;
    if (t.streams.length) html += `<h3>${esc(T.streamsLabel)}</h3><div class="tags">${t.streams.map((x) => `<span class="tag">${esc(x)}</span>`).join('')}</div>`;
    if (t.gartner.length) html += `<h3>${esc(T.gartnerHead)}</h3><ul>${t.gartner.map((g) => `<li>${esc(g.market)} <small>(${esc(g.vendor)})</small>${g.url ? ' · ' + link(g.url, T.report) : ''}</li>`).join('')}</ul>`;
    html += `<h3>${esc(T.sourceHead)}</h3><p class="small">${t.source ? link(t.source, host(t.source)) : ''}${t.checked ? ` · ${esc(T.checkedOn)} ${esc(date(t.checked))}` : ''}<br>${esc(t.descSource === 'producer' ? T.fromProducer : t.descSource ? T.fromThird : '')}</p>`;
    if (t.note) html += `<p class="small muted">${esc(t.note)}</p>`;
    if (t.url) html += `<p>${link(t.url, T.website)}</p>`;
    return html;
  }

  function pager(pages: number) {
    const p = state.page;
    const nums = [...new Set([1, p - 2, p - 1, p, p + 1, p + 2, pages])].filter((n) => n >= 1 && n <= pages).sort((a, b) => a - b);
    let html = `<button type="button" data-page="${p - 1}" ${p === 1 ? 'disabled' : ''}>‹ ${esc(T.prev)}</button>`;
    let last = 0;
    for (const n of nums) {
      if (n - last > 1) html += '<span>…</span>';
      html += `<button type="button" data-page="${n}" ${n === p ? 'aria-current="page" class="on"' : ''}>${n}</button>`;
      last = n;
    }
    return html + `<button type="button" data-page="${p + 1}" ${p === pages ? 'disabled' : ''}>${esc(T.next)} ›</button>`;
  }

  function update(change: Partial<typeof state>) {
    Object.assign(state, { page: 1 }, change);
    render();
  }

  root.querySelector('.atlas-tabs')!.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-view]');
    if (b) update({ view: b.dataset.view!, group: '', sub: '' });
  });
  $('atlas-caps').addEventListener('click', (e: Event) => {
    const a = (e.target as HTMLElement).closest<HTMLElement>('a[data-group]');
    if (!a) return;
    e.preventDefault();
    update({ group: a.dataset.group!, sub: a.dataset.sub! });
  });
  let timer = 0;
  $('atlas-q').addEventListener('input', (e: Event) => { clearTimeout(timer); timer = window.setTimeout(() => update({ q: (e.target as HTMLInputElement).value.trim() }), 200); });
  $('atlas-sort').addEventListener('change', (e: Event) => update({ sort: (e.target as HTMLSelectElement).value }));
  $('atlas-domains').addEventListener('click', (e: Event) => {
    const a = (e.target as HTMLElement).closest<HTMLElement>('a[data-domain]');
    if (!a) return;
    e.preventDefault();
    update({ domain: a.dataset.domain! });
  });
  $('atlas-streams').addEventListener('click', (e: Event) => {
    const a = (e.target as HTMLElement).closest<HTMLElement>('a[data-stream]');
    if (!a) return;
    e.preventDefault();
    update({ stream: a.dataset.stream! });
  });
  // A logo that does not load makes way for the next candidate, and finally for the initials.
  root.addEventListener('error', (e) => {
    const img = e.target as HTMLImageElement;
    if (img.tagName !== 'IMG' || !img.closest('.logo')) return;
    const [next, ...rest] = (img.dataset.next ?? '').split(' ').filter(Boolean);
    if (next) { img.dataset.next = rest.join(' '); img.src = next; } else img.remove();
  }, true);
  const dialog = $('atlas-dialog') as HTMLDialogElement;
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  $('atlas-list').addEventListener('click', (e: Event) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('button[data-tool]');
    if (b) {
      const t = tools.find((x) => x.id === b.dataset.tool);
      if (t) { dialog.innerHTML = profile(t); dialog.showModal(); }
      return;
    }
    if ((e.target as HTMLElement).id !== 'atlas-reset') return;
    e.preventDefault();
    update({ view: '', group: '', sub: '', q: '', stream: '', domain: '' });
  });
  $('atlas-pages').addEventListener('click', (e: Event) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-page]');
    if (!b || b.disabled) return;
    state.page = +b.dataset.page!;
    render();
    root.querySelector('.atlas-tabbar')!.scrollIntoView({ behavior: 'smooth' });
  });
  $('atlas-export').addEventListener('click', () => {
    const rows = [['Product', 'Producer', 'Description', 'Capability groups', 'Subcategories', 'IT4IT value streams', 'CSDM 5 domains', 'Gartner MQ 2026 markets', 'Producer website', 'Source', 'Source checked']];
    for (const t of current) {
      const subs = subsInView(t);
      rows.push([t.name, t.vendor, t.description, [...new Set(subs.map((s) => SUB[s]?.group))].join('; '), subs.map((s) => SUB[s]?.name ?? s).join('; '), t.streams.join('; '), t.domains.map((d) => DOMAIN[d] ?? d).join('; '), t.gartner.map((g) => g.market).join('; '), t.url, t.source, t.checked]);
    }
    const blob = new Blob([xlsx('IT4IT Atlas', rows, [40, 30, 80, 35, 45, 30, 35, 45, 40, 50, 14])], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `IT4IT-Atlas-${new Date().toISOString().slice(0, 10)}-${current.length}-tools.xlsx`;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  });

  // On a phone the capability list starts folded, so the tools come first.
  if (matchMedia('(max-width: 900px)').matches) root.querySelectorAll('.atlas-side details').forEach((d) => d.removeAttribute('open'));
  readUrl();
  fetch('/atlas/tools.json')
    .then((r) => { if (!r.ok) throw new Error(String(r.status)); return r.json(); })
    .then((data: Tool[]) => { tools = data; render(); })
    .catch(() => { $('atlas-list').innerHTML = `<p>${esc(T.error)}</p>`; });
</script>

