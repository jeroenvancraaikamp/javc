---
// Comments under an article: approved comments plus a form. New comments wait for approval on /comments.
const { slug, linkedin } = Astro.props as { slug: string; linkedin?: string };
---
<section class="comments" id="comments" data-slug={slug}>
  <h3>Comments</h3>
  <ol class="comment-list"></ol>
  <p class="muted no-comments" hidden>No comments yet. Be the first to share your thoughts.</p>
  {linkedin && (
    <p class="linkedin-discuss">
      <a class="btn linkedin-btn" href={linkedin} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.5c0-1.3-.02-3-1.83-3-1.83 0-2.1 1.43-2.1 2.9V21H9z"/></svg>
        Discuss this article on LinkedIn
      </a>
      <span class="muted">or leave a comment below.</span>
    </p>
  )}
  <h4>Leave a comment</h4>
  <form class="contact-form comment-form">
    <label>Comment *<textarea name="body" rows="5" maxlength="3000" required></textarea></label>
    <div class="comment-fields">
      <label>Name *<input name="name" maxlength="100" required /></label>
      <label>Email * <small class="muted">(not published)</small><input name="email" type="email" maxlength="200" required /></label>
    </div>
    <label class="hp" aria-hidden="true">Leave this field empty<input name="hp_note" tabindex="-1" autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore /></label>
    <button class="btn" type="submit">Post comment</button>
    <p class="notice" role="status" hidden></p>
  </form>
</section>

<script>
  import { protect } from '../scripts/botcheck';
  const box = document.getElementById('comments');
  if (box) {
    const slug = box.dataset.slug!;
    const list = box.querySelector('.comment-list') as HTMLOListElement;
    const empty = box.querySelector('.no-comments') as HTMLElement;
    const fmt = (ts: number) => new Date(ts).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
    fetch(`/api/comments?slug=${encodeURIComponent(slug)}`)
      .then((r) => r.json())
      .then(({ comments = [] }) => {
        for (const c of comments) {
          const li = document.createElement('li');
          const head = document.createElement('div');
          head.className = 'comment-head';
          const who = document.createElement('strong');
          who.textContent = c.name;
          const when = document.createElement('small');
          when.textContent = fmt(c.ts);
          head.append(who, when);
          const body = document.createElement('p');
          body.textContent = c.body;
          li.append(head, body);
          list.append(li);
        }
        empty.hidden = comments.length > 0;
        document.querySelectorAll('[data-comment-count]').forEach((el) => {
          el.textContent = comments.length === 1 ? '1 Comment' : `${comments.length} Comments`;
        });
      })
      .catch(() => { empty.hidden = false; });

    const form = box.querySelector('form') as HTMLFormElement;
    const notice = form.querySelector('.notice') as HTMLElement;
    const btn = form.querySelector('button') as HTMLButtonElement;
    const bot = protect(form);
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.disabled = true;
      const data = Object.fromEntries(new FormData(form));
      const res = await fetch('/api/comments', {
        method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ ...data, ...bot.extra(), slug }),
      }).catch(() => null);
      const out = res ? await res.json().catch(() => ({})) : {};
      notice.hidden = false;
      if (res?.ok) {
        notice.className = 'notice ok';
        notice.textContent = 'Thank you! Your comment will appear here once it has been approved.';
        form.reset();
      } else {
        notice.className = 'notice error';
        notice.textContent = out.error || 'Something went wrong. Please try again later.';
      }
      bot.reset();
      btn.disabled = false;
    });
  }
</script>

<style is:global>
  .comments { margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--line); }
  .comments .comment-list { list-style: none; padding: 0; margin: 0 0 24px; display: grid; gap: 14px; }
  .comments .comment-list li { padding: 14px 16px; background: var(--bg-soft); border-radius: var(--radius); }
  .comments .comment-head { display: flex; gap: 10px; align-items: baseline; flex-wrap: wrap; }
  .comments .comment-head small { color: var(--muted); }
  .comments .comment-list p { margin: 6px 0 0; white-space: pre-line; }
  .comments .comment-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .comments .linkedin-discuss { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin: 0 0 24px; }
  .comments .linkedin-btn { display: inline-flex; align-items: center; gap: 8px; background: #0a66c2; }
  .comments .linkedin-btn svg { width: 16px; height: 16px; fill: currentColor; }
  @media (max-width: 640px) { .comments .comment-fields { grid-template-columns: 1fr; } }
</style>
