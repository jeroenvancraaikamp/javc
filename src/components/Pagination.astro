---
interface Props { page: { currentPage: number; lastPage: number; url: { prev?: string; next?: string } }; base: string }
const { page, base } = Astro.props;
const pages = Array.from({ length: page.lastPage }, (_, i) => i + 1);
const url = (n: number) => (n === 1 ? base : `${base}${n}/`);
---
{page.lastPage > 1 && (
  <nav class="pagination" aria-label="Pagination">
    {page.url.prev && <a href={page.url.prev}>‹ Previous</a>}
    {pages.map((n) => n === page.currentPage ? <span class="current">{n}</span> : <a href={url(n)}>{n}</a>)}
    {page.url.next && <a href={page.url.next}>Next ›</a>}
  </nav>
)}
