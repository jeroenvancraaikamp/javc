---
import { getArticles, getCategories, getArchives, monthName, formatDate, pad } from '../lib';
const articles = await getArticles();
const recent = articles.slice(0, 3);
const flagged = articles.filter((a) => a.data.popular);
const popular = [...flagged, ...recent.filter((a) => !flagged.includes(a))].slice(0, 3);
const categories = await getCategories();
const archives = await getArchives();
---
<aside class="sidebar">
  <section class="widget">
    <form action="/search/" method="get" role="search" class="searchform">
      <label for="s" class="sr">Search for:</label>
      <input id="s" name="q" type="search" placeholder="Search..." />
      <button type="submit" aria-label="Search">🔍</button>
    </form>
  </section>
  <section class="widget tabs">
    <div class="tab-buttons" role="tablist">
      <button role="tab" aria-selected="true" data-tab="popular">Popular</button>
      <button role="tab" aria-selected="false" data-tab="recent">Recent</button>
      <button role="tab" aria-selected="false" data-tab="comments">Comments</button>
    </div>
    <ul class="tab-panel" data-panel="popular">
      {popular.map((a) => (
        <li><a href={`/${a.id}/`}>{a.data.title}</a><small>{formatDate(a.data.date)}</small></li>
      ))}
    </ul>
    <ul class="tab-panel" data-panel="recent" hidden>
      {recent.map((a) => <li><a href={`/${a.id}/`}>{a.data.title}</a><small>{formatDate(a.data.date)}</small></li>)}
    </ul>
    <ul class="tab-panel" data-panel="comments" hidden><li class="muted">No comments have been published yet.</li></ul>
  </section>
  <section class="widget">
    <h4>Categories</h4>
    <ul class="list">
      {categories.map((c) => <li><a href={`/category/${c.slug}/`}>{c.name}</a> <span>({c.count})</span></li>)}
    </ul>
  </section>
  <section class="widget">
    <h4>Archives</h4>
    <ul class="list">
      {archives.map((m) => (
        <li><a href={`/archive/${m.year}/${pad(m.month)}/`}>{monthName(m.month)} {m.year}</a> <span>({m.count})</span></li>
      ))}
    </ul>
  </section>
</aside>
<script>
  // Latest approved comments for the Comments tab.
  fetch('/api/comments?latest=1').then((r) => r.json()).then(({ comments = [] }) => {
    if (!comments.length) return;
    document.querySelectorAll<HTMLElement>('[data-panel="comments"]').forEach((ul) => {
      ul.replaceChildren(...comments.map((c: { slug: string; name: string; body: string; ts: number }) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `/${c.slug}/#comments`;
        a.textContent = `${c.name}: ${c.body.length >= 120 ? c.body + '…' : c.body}`;
        const small = document.createElement('small');
        small.textContent = new Date(c.ts).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
        li.append(a, small);
        return li;
      }));
    });
  }).catch(() => {});
  document.querySelectorAll('.tabs').forEach((w) => {
    w.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) =>
      b.addEventListener('click', () => {
        w.querySelectorAll('[data-tab]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
        w.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== b.dataset.tab));
      }),
    );
  });
</script>
