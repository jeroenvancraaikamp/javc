---
import { getArticles, getCategories, getArchives, monthName, formatDate, pad } from '../lib';
import { langOf, url, t, categoryName } from '../i18n';
const lang = langOf(Astro.url.pathname);
const T = t(lang);
const articles = await getArticles(lang);
const recent = articles.slice(0, 3);
const flagged = articles.filter((a) => a.data.popular);
const popular = [...flagged, ...recent.filter((a) => !flagged.includes(a))].slice(0, 3);
const categories = await getCategories(lang);
const archives = await getArchives(lang);
---
<aside class="sidebar">
  <section class="widget">
    <form action={url(lang, '/search/')} method="get" role="search" class="searchform">
      <label for="s" class="sr">{T.searchFor}</label>
      <input id="s" name="q" type="search" placeholder={T.searchPh} />
      <button type="submit" aria-label={T.search}>🔍</button>
    </form>
  </section>
  <section class="widget tabs">
    <div class="tab-buttons" role="tablist">
      <button role="tab" aria-selected="true" data-tab="popular">{T.popular}</button>
      <button role="tab" aria-selected="false" data-tab="recent">{T.recent}</button>
    </div>
    <ul class="tab-panel" data-panel="popular">
      {popular.map((a) => (
        <li><a href={url(lang, `/${a.id}/`)}>{a.data.title}</a><small>{formatDate(a.data.date, lang)}</small></li>
      ))}
    </ul>
    <ul class="tab-panel" data-panel="recent" hidden>
      {recent.map((a) => <li><a href={url(lang, `/${a.id}/`)}>{a.data.title}</a><small>{formatDate(a.data.date, lang)}</small></li>)}
    </ul>
  </section>
  <section class="widget">
    <h4>{T.categories}</h4>
    <ul class="list">
      {categories.map((c) => <li><a href={url(lang, `/category/${c.slug}/`)}>{categoryName(c.name, lang)}</a> <span>({c.count})</span></li>)}
    </ul>
  </section>
  <section class="widget">
    <h4>{T.archives}</h4>
    <ul class="list">
      {archives.map((m) => (
        <li><a href={url(lang, `/archive/${m.year}/${pad(m.month)}/`)}>{monthName(m.month, lang)} {m.year}</a> <span>({m.count})</span></li>
      ))}
    </ul>
  </section>
</aside>
<script>
  document.querySelectorAll('.tabs').forEach((w) => {
    w.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) =>
      b.addEventListener('click', () => {
        w.querySelectorAll('[data-tab]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
        w.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== b.dataset.tab));
      }),
    );
  });
</script>
