---
import '../styles/site.css';
import { SITE, getPages } from '../lib';
import { langOf, switchPath, url, t, other, locale } from '../i18n';
import ChatWidget from '../components/ChatWidget.astro';

interface Props {
  title: string;
  description?: string;
  pageTitle?: string;
  crumbs?: { label: string; href?: string }[];
  edit?: string;
  noindex?: boolean;
  chat?: boolean;
}
const path = Astro.url.pathname;
// The language follows the address: /nl/... is Dutch, everything else English.
const lang = langOf(path);
const T = t(lang);
const { title, description = T.description, pageTitle, crumbs = [], edit, noindex = false, chat = true } = Astro.props;
const menu = (await getPages(lang)).filter((p) => p.data.menu).sort((a, b) => a.data.order - b.data.order);
const isActive = (href: string) => path === href || (href !== url(lang, '/') && path.startsWith(href));
const articlesActive = ['/articles/', '/category/', '/archive/', '/search/'].some((p) => path.startsWith(url(lang, p)));
// Pages for signed-in use only (stats, editor) exist in English only, so they get no language switch.
const alt = noindex ? null : switchPath(path);
const site = Astro.site?.origin ?? 'https://javc.nl';
---
<!doctype html>
<html lang={locale[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === SITE.name ? title : `${title} – ${SITE.name}`}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {alt && (
      <>
        <link rel="alternate" hreflang={lang} href={site + path} />
        <link rel="alternate" hreflang={other(lang)} href={site + alt} />
        <link rel="alternate" hreflang="x-default" href={site + (lang === 'en' ? path : alt)} />
      </>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&family=Montserrat:wght@500;600;700&display=swap" rel="stylesheet" />
    {SITE.gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`}></script>
        <script is:inline define:vars={{ gaId: SITE.gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip" href="#content">{T.skip}</a>
    <div class="topbar">
      <div class="wrap">
        <a href={SITE.linkedin} aria-label="LinkedIn" class="social" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.5c0-1.3-.02-3-1.83-3-1.83 0-2.1 1.43-2.1 2.9V21H9z"/></svg>
        </a>
        <a href="mailto:info@javc.nl" aria-label="Email" class="social">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18v14H3zm2 2v.5l7 4.5 7-4.5V7zm14 2.9-7 4.5-7-4.5V17h14z"/></svg>
        </a>
        <a href="tel:+31643583097" aria-label="Phone" class="social">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>
        </a>
        <span class="publish-status" role="status" hidden></span>
        <a href="/stats" aria-label="Statistics" title="Statistics" class="social cms-stats" hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10h3v10zm6.5 0V4h3v16zM17 20v-7h3v7z"/></svg>
        </a>
        <a href="/cms/" aria-label="Sign in to the editor" title="Sign in to the editor" class="social cms-lock">
          <svg class="lock-closed" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a5 5 0 0 0-5 5v3H5v12h14V10h-2V7a5 5 0 0 0-5-5zm-3 8V7a3 3 0 0 1 6 0v3zm3 4a2 2 0 0 1 1 3.7V20h-2v-2.3A2 2 0 0 1 12 14z"/></svg>
          <svg class="lock-open" viewBox="0 0 24 24" aria-hidden="true" hidden><path d="M12 2a5 5 0 0 0-5 5h2a3 3 0 0 1 6 0v3H5v12h14V10h-2V7a5 5 0 0 0-5-5zm0 12a2 2 0 0 1 1 3.7V20h-2v-2.3A2 2 0 0 1 12 14z"/></svg>
        </a>
      </div>
    </div>
    <header class="masthead">
      <div class="wrap">
        <a href={url(lang, '/')} class="logo"><img src="/wp-content/uploads/2022/12/JAVC-1.png" alt="JAVC Management &amp; Consultancy" width="300" height="60" /></a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="nav">☰ <span>{T.menu}</span></button>
        <nav id="nav" aria-label="Main">
          <ul>
            {menu.map((p) => {
              const href = url(lang, `/${p.id}/`);
              return <li><a href={href} class:list={{ active: isActive(href) }}>{p.data.menu}</a></li>;
            })}
            <li><a href={url(lang, '/articles/')} class:list={{ active: articlesActive }}>{T.articles}</a></li>
            <li><a href={url(lang, '/contact-me/')} class:list={{ active: isActive(url(lang, '/contact-me/')) }}>{T.contact}</a></li>
          </ul>
        </nav>
        {alt && (
          <nav class="lang-switch" aria-label="Language / Taal">
            <a href={lang === 'en' ? path : alt} hreflang="en" lang="en" title="English" aria-current={lang === 'en' ? 'page' : undefined}>
              <svg viewBox="0 0 60 30" aria-hidden="true"><clipPath id="uk-t"><path d="M30 15h30v15zv15H0zH0V0zV0h30z"/></clipPath><path d="M0 0v30h60V0z" fill="#012169"/><path d="M0 0l60 30m0-30L0 30" stroke="#fff" stroke-width="6"/><path d="M0 0l60 30m0-30L0 30" clip-path="url(#uk-t)" stroke="#C8102E" stroke-width="4"/><path d="M30 0v30M0 15h60" stroke="#fff" stroke-width="10"/><path d="M30 0v30M0 15h60" stroke="#C8102E" stroke-width="6"/></svg>
              <span>EN</span>
            </a>
            <a href={lang === 'nl' ? path : alt} hreflang="nl" lang="nl" title="Nederlands" aria-current={lang === 'nl' ? 'page' : undefined}>
              <svg viewBox="0 0 9 6" aria-hidden="true"><path fill="#21468B" d="M0 0h9v6H0z"/><path fill="#fff" d="M0 0h9v4H0z"/><path fill="#AE1C28" d="M0 0h9v2H0z"/></svg>
              <span>NL</span>
            </a>
          </nav>
        )}
      </div>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="footer">
      <div class="copyright">
        <div class="wrap">
          <span>© 2022–{new Date().getFullYear()} <a href={url(lang, '/contact-me/')}>{SITE.name}</a> · <a href={url(lang, '/privacy-policy/')}>{T.privacy}</a> · <a href={url(lang, '/algemene-voorwaarden/')}>{T.terms}</a></span>
        </div>
      </div>
    </footer>
    <a href="#" class="to-top" aria-label={T.toTop}>▲</a>
    {chat && <ChatWidget lang={lang} />}
    {edit && (
      <a id="cms-edit" href={`/cms/#/collections/${edit}`} hidden
        style="position:fixed;left:16px;bottom:16px;z-index:50;padding:8px 14px;border-radius:999px;background:#111;color:#fff;font:600 14px system-ui,sans-serif;text-decoration:none;box-shadow:0 2px 8px rgba(0,0,0,.3)">✎ Edit</a>
    )}
    <script>
      // Signed in to this site's CMS? (Sveltia keeps its login, with the GitHub token, in localStorage.)
      const signedIn = () => {
        try { return !!JSON.parse(localStorage.getItem('sveltia-cms.user') || '{}').token; } catch { return false; }
      };
      // Edit button, lock icon (open when signed in) and stats icon follow the CMS login,
      // also when you sign in or out in the CMS on another tab or in the embedded editor (/cms/).
      const showLogin = () => {
        const on = signedIn();
        const btn = document.getElementById('cms-edit');
        if (btn) btn.hidden = !on;
        const lock = document.querySelector('.cms-lock');
        lock?.querySelector('.lock-closed')?.toggleAttribute('hidden', on);
        lock?.querySelector('.lock-open')?.toggleAttribute('hidden', !on);
        lock?.setAttribute('aria-label', on ? 'Open the editor' : 'Sign in to the editor');
        lock?.setAttribute('title', on ? 'Open the editor' : 'Sign in to the editor');
        document.querySelector('.cms-stats')?.toggleAttribute('hidden', !on);
      };
      showLogin();
      addEventListener('storage', (e) => { if (e.key === null || e.key === 'sveltia-cms.user') showLogin(); });
      // Page view for the stats page (/stats); not counted when signed in to the CMS.
      if (!signedIn()) {
        fetch('/api/hit', { method: 'POST', keepalive: true, headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ p: location.pathname, r: document.referrer }) }).catch(() => {});
      }
    </script>
    <script>
      import '../scripts/publish-status';
    </script>
    <script>
      const t = document.querySelector('.menu-toggle');
      t?.addEventListener('click', () => {
        const open = document.body.classList.toggle('nav-open');
        t.setAttribute('aria-expanded', String(open));
      });
      const top = document.querySelector('.to-top') as HTMLElement;
      addEventListener('scroll', () => top.classList.toggle('show', scrollY > 400), { passive: true });
      top.addEventListener('click', (e) => { e.preventDefault(); scrollTo({ top: 0, behavior: 'smooth' }); });
    </script>
  </body>
</html>
