---
import '../styles/site.css';
import { getCollection } from 'astro:content';
import { SITE } from '../lib';

interface Props {
  title: string;
  description?: string;
  pageTitle?: string;
  crumbs?: { label: string; href?: string }[];
}
const { title, description = 'IT management and consultancy by Jeroen van Craaikamp.', pageTitle, crumbs = [] } = Astro.props;
const menu = (await getCollection('pages')).filter((p) => p.data.menu).sort((a, b) => a.data.order - b.data.order);
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
const articlesActive = ['/articles/', '/category/', '/archive/', '/search/'].some((p) => path.startsWith(p));
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === SITE.name ? title : `${title} – ${SITE.name}`}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&family=Montserrat:wght@500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <div class="topbar">
      <div class="wrap">
        <a href={SITE.linkedin} aria-label="LinkedIn" class="social" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.5c0-1.3-.02-3-1.83-3-1.83 0-2.1 1.43-2.1 2.9V21H9z"/></svg>
        </a>
        <a href="mailto:info@javc.nl" aria-label="Email" class="social">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18v14H3zm2 2v.5l7 4.5 7-4.5V7zm14 2.9-7 4.5-7-4.5V17h14z"/></svg>
        </a>
        <a href="tel:+31643583097" aria-label="Phone" class="social">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>
        </a>
      </div>
    </div>
    <header class="masthead">
      <div class="wrap">
        <a href="/" class="logo"><img src="/wp-content/uploads/2022/12/JAVC-1.png" alt="JAVC Management &amp; Consultancy" width="300" height="60" /></a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="nav">☰ <span>Menu</span></button>
        <nav id="nav" aria-label="Main">
          <ul>
            {menu.map((p) => {
              const href = `/${p.id}/`;
              return <li><a href={href} class:list={{ active: isActive(href) }}>{p.data.menu}</a></li>;
            })}
            <li><a href="/articles/" class:list={{ active: articlesActive }}>Articles/Publications</a></li>
            <li><a href="/contact-me/" class:list={{ active: isActive('/contact-me/') }}>Contact me</a></li>
          </ul>
        </nav>
      </div>
    </header>
    {pageTitle && (
      <div class="titlebar">
        <div class="wrap">
          <h1>{pageTitle}</h1>
          <ol class="crumbs">
            <li><a href="/">Home</a></li>
            {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : c.label}</li>)}
          </ol>
        </div>
      </div>
    )}
    <main id="content">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap footer-cols">
        <div>
          <h4>JAVC</h4>
          <p>Independent IT management &amp; consultancy. IT4IT, ESM, CSM and ServiceNow for large enterprises.</p>
        </div>
        <div>
          <h4>Contact</h4>
          <p>Amstelveen, The Netherlands<br /><a href="mailto:info@javc.nl">info@javc.nl</a></p>
        </div>
        <div>
          <h4>Explore</h4>
          <p><a href="/articles/">Articles/Publications</a><br /><a href="/it4it-atlas/">IT4IT Atlas</a><br /><a href="/contact-me/">Contact me</a></p>
        </div>
      </div>
      <div class="copyright">
        <div class="wrap">
          <span>© 2022–{new Date().getFullYear()} {SITE.name} · <a href="/privacy-policy/">Privacy policy</a> · <a href="/algemene-voorwaarden/">Algemene voorwaarden</a></span>
          <a href={SITE.linkedin} class="social" aria-label="LinkedIn">in</a>
        </div>
      </div>
    </footer>
    <a href="#" class="to-top" aria-label="Go to Top">▲</a>
    <script>
      const t = document.querySelector('.menu-toggle');
      t?.addEventListener('click', () => {
        const open = document.body.classList.toggle('nav-open');
        t.setAttribute('aria-expanded', String(open));
      });
      const top = document.querySelector('.to-top') as HTMLElement;
      addEventListener('scroll', () => top.classList.toggle('show', scrollY > 400), { passive: true });
      top.addEventListener('click', (e) => { e.preventDefault(); scrollTo({ top: 0, behavior: 'smooth' }); });
    </script>
  </body>
</html>
