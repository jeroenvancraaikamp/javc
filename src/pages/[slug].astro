---
import { render, getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import { marked } from 'marked';
import { getArticles, slugify, formatDate, SITE } from '../lib';

export async function getStaticPaths() {
  const articles = await getArticles();
  const pages = await getCollection('pages');
  return [
    ...articles.map((entry) => ({
      params: { slug: entry.id },
      props: { entry, kind: 'article', all: articles },
    })),
    ...pages.map((entry) => ({ params: { slug: entry.id }, props: { entry, kind: 'page' } })),
  ];
}
const { entry, kind, all } = Astro.props as any;
const { Content } = await render(entry);
const d = entry.data;
// Column layout: every '## ' section becomes a block in a two-column grid.
const sections = kind === 'page' && d.layout === 'columns'
  ? (entry.body ?? '').split(/^(?=## )/m).map((part: string) => marked.parse(part) as string)
  : [];
const intro = sections.length && !(entry.body ?? '').trimStart().startsWith('## ') ? sections.shift() : '';
const related = kind === 'article'
  ? all.filter((a: any) => a.id !== entry.id && a.data.categories.some((c: string) => d.categories.includes(c))).slice(0, 3)
  : [];
---
{kind === 'page' ? (
  <Base title={d.title} edit={`pages/entries/${entry.id}`} pageTitle={d.title} crumbs={[{ label: d.title }]}>
    {d.layout === 'columns' ? (
      <div class="wrap page-body page-columns">
        {d.banner && <img class="banner" src={d.banner} alt="" />}
        {intro && <div class="prose" set:html={intro} />}
        <div class="columns">{sections.map((html: string) => <section class="prose" set:html={html} />)}</div>
      </div>
    ) : (
      <div class:list={["wrap page-body", { wide: d.wide, 'page-columns': d.banner }]}>
        {d.banner && <img class="banner" src={d.banner} alt="" />}
        <div class="prose"><Content /></div>
      </div>
    )}
  </Base>
) : (
  <Base title={d.title} edit={`articles/entries/${entry.id}`} description={d.excerpt} pageTitle={d.title} crumbs={[{ label: 'Articles/Publications', href: '/articles/' }, { label: d.title }]}>
    <div class="wrap layout">
      <article class="primary single">
        <h1 class="post-title">{d.title}</h1>
        <img class="featured" src={d.image || `/images/${entry.id}.svg`} alt="" width="1200" height="675" />
        <div class="meta">
          By {SITE.author} · {formatDate(d.date)} · {d.categories.map((c: string, i: number) => <>{i > 0 && ', '}<a href={`/category/${slugify(c)}/`}>{c}</a></>)}
          {d.readingTime && <> · {d.readingTime} min read</>}
        </div>
        <div class="prose"><Content /></div>
        {d.linkedin && (
          <p class="linkedin-discuss">
            <a class="btn linkedin-btn" href={d.linkedin} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.5c0-1.3-.02-3-1.83-3-1.83 0-2.1 1.43-2.1 2.9V21H9z"/></svg>
              Discuss this article on LinkedIn
            </a>
          </p>
        )}
        {related.length > 0 && (
          <section class="related">
            <h3>Related Posts</h3>
            <div class="related-grid">
              {related.map((r: any) => (
                <a href={`/${r.id}/`}><img src={r.data.image || `/images/${r.id}.svg`} alt="" loading="lazy" /><span>{r.data.title}</span><small>{formatDate(r.data.date)}</small></a>
              ))}
            </div>
          </section>
        )}
      </article>
      <Sidebar />
    </div>
  </Base>
)}
