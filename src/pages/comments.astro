---
// Moderation of comments: approve, hide or delete. Only for the owner, signed in to the CMS
// (the list comes from /api/comments?all=1, see worker/comments.js).
import Base from '../layouts/Base.astro';
---
<Base title="Comments" noindex>
  <div class="wrap moderate">
    <h1>Comments</h1>
    <p class="muted">New comments wait here until you approve them. Approved comments appear under the article.</p>
    <div id="mod-out"><p class="muted">Loading…</p></div>
  </div>
  <script>
    const out = document.getElementById('mod-out')!;
    const login = '<p>This page is only visible when you are signed in to the CMS. <a href="/cms/">Sign in to the CMS</a>, then open this page again.</p>';
    let token = '';
    try { token = JSON.parse(localStorage.getItem('sveltia-cms.user') || '{}').token || ''; } catch {}
    const auth = { authorization: 'Bearer ' + token };
    const fmt = (ts: number) => new Date(ts).toLocaleString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });

    async function load() {
      if (!token) { out.innerHTML = login; return; }
      const res = await fetch('/api/comments?all=1', { headers: auth }).catch(() => null);
      if (res?.status === 401) { out.innerHTML = login; return; }
      if (!res?.ok) { out.innerHTML = '<p>Comments are not available right now. Please try again later.</p>'; return; }
      const { comments } = await res.json();
      if (!comments.length) { out.innerHTML = '<p class="muted">No comments yet.</p>'; return; }
      out.replaceChildren(...comments.map((c: any) => {
        const card = document.createElement('div');
        card.className = `mod-card ${c.status}`;
        const head = document.createElement('div');
        head.className = 'mod-head';
        const status = document.createElement('span');
        status.className = 'mod-status';
        status.textContent = c.status === 'approved' ? 'Approved' : 'Waiting for approval';
        const who = document.createElement('strong');
        who.textContent = c.name;
        const mail = document.createElement('a');
        mail.href = `mailto:${c.email}`;
        mail.textContent = c.email;
        const on = document.createElement('a');
        on.href = `/${c.slug}/#comments`;
        on.textContent = `/${c.slug}/`;
        const when = document.createElement('small');
        when.textContent = fmt(c.ts);
        head.append(status, who, mail, on, when);
        const body = document.createElement('p');
        body.textContent = c.body;
        const actions = document.createElement('div');
        actions.className = 'mod-actions';
        const button = (label: string, action: string, cls = '') => {
          const b = document.createElement('button');
          b.textContent = label;
          b.className = `btn ${cls}`;
          b.addEventListener('click', async () => {
            if (action === 'delete' && !confirm('Delete this comment for good?')) return;
            b.disabled = true;
            await fetch('/api/comments/moderate', {
              method: 'POST', headers: { ...auth, 'content-type': 'application/json' }, body: JSON.stringify({ id: c.id, action }),
            });
            load();
          });
          return b;
        };
        actions.append(
          c.status === 'approved' ? button('Hide', 'hide', 'ghost') : button('Approve', 'approve'),
          button('Delete', 'delete', 'ghost'),
        );
        card.append(head, body, actions);
        return card;
      }));
    }
    load();
  </script>
</Base>

<style is:global>
  .moderate { padding-top: 30px; padding-bottom: 50px; }
  .mod-card { border: 1px solid var(--line); border-left: 4px solid #d9a400; border-radius: var(--radius); padding: 14px 16px; margin-bottom: 14px; }
  .mod-card.approved { border-left-color: var(--accent); }
  .mod-head { display: flex; gap: 12px; flex-wrap: wrap; align-items: baseline; font-size: 14px; }
  .mod-head small { color: var(--muted); }
  .mod-status { font-size: 12px; font-weight: 600; text-transform: uppercase; color: #9a7400; }
  .mod-card.approved .mod-status { color: var(--accent); }
  .mod-card p { margin: 8px 0 12px; white-space: pre-line; }
  .mod-actions { display: flex; gap: 8px; }
  .mod-actions .btn.ghost { background: transparent; color: var(--text) !important; border: 1px solid var(--line); }
</style>
