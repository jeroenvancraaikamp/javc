---
import Base from '../layouts/Base.astro';
---
<Base title="Contact me" pageTitle="Contact me" crumbs={[{ label: 'Contact me' }]}>
  <div class="wrap contact">
    <div>
      <p class="intro">Tell me about your needs, ask your question or just say hello.</p>
      <form class="contact-form" id="contact">
        <label>Name *<input name="name" required /></label>
        <label>Email *<input name="email" type="email" required /></label>
        <label>Phone *<input name="phone" type="tel" required /></label>
        <label>Message *<textarea name="message" rows="6" required></textarea></label>
        <button class="btn" type="submit">Submit message</button>
        <p class="notice" hidden>Prototype: this form is not connected yet. In the real site it would send the message to info@javc.nl.</p>
      </form>
    </div>
    <div class="contact-details">
      <h3>JAVC Management &amp; Consultancy</h3>
      <p>Att. Jeroen A. van Craaikamp<br />Randwijcklaan 1<br />1181 BL Amstelveen<br />The Netherlands</p>
      <p>Phone: <a href="tel:+31643583097">+31-6-43583097</a><br />Email: <a href="mailto:info@javc.nl">Info@JAVC.nl</a></p>
      <p class="muted">KvK No.: 87947064<br />V.A.T. No.: NL004522154B44<br />IBAN: NL48KNAB0513732187 (BIC KNABNL2H)</p>
    </div>
  </div>
  <script>
    document.getElementById('contact')?.addEventListener('submit', (e) => {
      e.preventDefault();
      (document.querySelector('.contact-form .notice') as HTMLElement).hidden = false;
    });
  </script>
</Base>
