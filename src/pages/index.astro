---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib';
import { marked } from 'marked';
// Homepage text: edit in the CMS (/admin/ → Startpagina) or in src/data/home.json
import home from '../data/home.json';
---
<Base title={SITE.name}>
  <section class="hero">
    <video class="hero-video" autoplay muted loop playsinline preload="auto" poster="/media/hero-poster.jpg" aria-hidden="true">
      <source src="/media/hero.mp4" type="video/mp4" />
    </video>
    <div class="hero-shade"></div>
    <div class="wrap hero-text">
      <h1>{home.title}</h1>
      <p class="hero-sub">{home.subtitle}</p>
      <p class="hero-body"><span>{home.text}</span></p>
    </div>
  </section>
  <section class="home-main">
    <div class="wrap">
      <p class="home-intro" set:html={marked.parseInline(home.intro)} />
      <div class="blocks">
        {home.blocks.map((b) => (
          <div class="block">
            <h2>{b.heading}</h2>
            <p>{b.text}</p>
            <a class="btn btn-dark" href={b.link}>{b.button}</a>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
