---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getArticles, SITE } from '../lib';
const latest = (await getArticles()).slice(0, 3);
const blocks = [
  { h: 'What I do', p: 'Together with stakeholders and agile team members, I plan, procure, innovate, integrate, implement and manage IT products/platforms for large enterprises.', cta: 'Skills/Expertise', href: '/skills/' },
  { h: 'So far', p: 'Over the last decades, I managed IT4IT and CSM projects/teams, as internal employee or external consultant in various technical, commercial and managerial roles.', cta: 'Projects/Assignments', href: '/experience/' },
  { h: 'For who', p: 'I worked for companies such as KPN, Belastingdienst, KLM, Ericsson China, Tellabs, ING Bank, CRH, Digital Realty, IKEA, Booking, Action, Brenntag, and Stater.', cta: 'Customers/Employers', href: '/customers-employers/' },
];
---
<Base title={SITE.name}>
  <section class="hero">
    <video class="hero-video" autoplay muted loop playsinline preload="auto" poster="/media/hero-poster.jpg" aria-hidden="true">
      <source src="/media/hero.mp4" type="video/mp4" />
    </video>
    <div class="hero-shade"></div>
    <div class="wrap hero-text">
      <h1>Welcome at JAVC Management &amp; Consultancy</h1>
      <p class="hero-sub">The website of Jeroen A. van Craaikamp in Amstelveen, Netherlands.</p>
      <p class="hero-body"><span>After building up skills and 20+ years of experience as an internal employee, companies, can now hire me as self-employed project/program manager, platform/product owner or architect in the Service Management workspace, utilizing IT4IT platforms such as ServiceNow.</span></p>
    </div>
  </section>
  <section class="home-main">
    <div class="wrap">
      <p class="home-intro">The "<a href="/articles/">Articles/Publications</a>" page features a few dozen blogs about the various things that keep me busy.</p>
      <div class="blocks">
        {blocks.map((b) => (
          <div class="block">
            <h2>{b.h}</h2>
            <p>{b.p}</p>
            <a class="btn btn-dark" href={b.href}>{b.cta}</a>
          </div>
        ))}
      </div>
      <div class="questions">
        <h2>Any questions?</h2>
        <a class="btn btn-dark" href="/contact-me/">Contact me</a>
      </div>
    </div>
  </section>
  <section class="wrap latest">
    <h2 class="section-title">Latest articles</h2>
    <div class="cards cards-3">{latest.map((a) => <PostCard article={a} />)}</div>
    <p class="center"><a class="btn" href="/articles/">All articles</a></p>
  </section>
</Base>
