---
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
---
<Base title="Search" pageTitle="Search results" crumbs={[{ label: 'Search' }]}>
  <div class="wrap layout">
    <div class="primary">
      <form class="searchform big" action="/search/">
        <input name="q" type="search" placeholder="Search articles..." id="q" />
        <button type="submit">Search</button>
      </form>
      <p id="summary" class="muted"></p>
      <div id="results" class="results"></div>
    </div>
    <Sidebar />
  </div>
  <script>
    const q = new URLSearchParams(location.search).get('q')?.trim() ?? '';
    const input = document.getElementById('q') as HTMLInputElement;
    input.value = q;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    if (q) {
      fetch('/search.json').then((r) => r.json()).then((items: any[]) => {
        const terms = q.toLowerCase().split(/\s+/);
        const hits = items.filter((i) => {
          const hay = `${i.title} ${i.excerpt} ${i.categories.join(' ')} ${i.text}`.toLowerCase();
          return terms.every((t) => hay.includes(t));
        });
        document.getElementById('summary')!.textContent = `${hits.length} result${hits.length === 1 ? '' : 's'} for “${q}”`;
        document.getElementById('results')!.innerHTML = hits.map((h) =>
          `<article class="result"><small>${esc(h.categories.join(', '))}</small><h2><a href="${h.url}">${esc(h.title)}</a></h2><p>${esc(h.excerpt)} [...]</p></article>`).join('');
      });
    }
  </script>
</Base>
