---
// Gartner Magic Quadrants of the IT4IT Atlas (/it4it-atlas/gartner/ and its translations): per Magic Quadrant the
// Atlas tools in it (product + producer), in two columns. Data comes from scripts/build-atlas.mjs (atlas-meta.json).
// The real MQ graphics are Gartner's copyright, so each block shows a neutral drawing of the MQ structure instead
// (no vendor positions) and links to the report at Gartner.
import META from '../data/atlas-meta.json';
import Base from '../layouts/Base.astro';
import { locale, url, langOf } from '../i18n';
import { ATLAS_TEXT } from '../data/atlas-text';

type Quadrant = { market: string; year: number; url: string; tools: { id: string; name: string; vendor: string }[] };
const lang = langOf(Astro.url.pathname);
const TEXT = ATLAS_TEXT[lang];
const nf = new Intl.NumberFormat(locale[lang]);
const quadrants = ((META as { quadrants?: Quadrant[] }).quadrants ?? []).map((q) => ({
  ...q,
  tools: [...q.tools].sort((a, b) => a.name.localeCompare(b.name, 'en', { sensitivity: 'base' })),
}));
const toolCount = new Set(quadrants.flatMap((q) => q.tools.map((t) => t.id))).size;
const atlas = url(lang, '/it4it-atlas/');
---
<Base title={`${TEXT.mqPage} · IT4IT Atlas`} pageTitle={TEXT.mqPage} crumbs={[{ label: 'IT4IT Atlas', href: atlas }, { label: TEXT.mqPage }]}>
  <div class="wrap page-body atlas-page">
    <section class="atlas-mq">
      <h1 class="atlas-guide-title">IT4IT Atlas · {TEXT.mqPage}</h1>
      <p>{TEXT.mqIntro(nf.format(toolCount), nf.format(quadrants.length))}</p>
      <div class="atlas-mq-grid">
        {quadrants.map((q) => (
          <article class="atlas-mq-block">
            <svg class="atlas-mq-pic" viewBox="0 0 400 230" role="img" aria-label={`${TEXT.mqPicture}: ${q.market}`}>
              <title>{TEXT.mqPicture}</title>
              <rect x="34" y="10" width="356" height="190" class="frame" />
              <rect x="34" y="10" width="178" height="95" class="q q1" />
              <rect x="212" y="10" width="178" height="95" class="q q2" />
              <rect x="34" y="105" width="178" height="95" class="q q3" />
              <rect x="212" y="105" width="178" height="95" class="q q4" />
              <text x="123" y="62" class="lbl">CHALLENGERS</text>
              <text x="301" y="62" class="lbl">LEADERS</text>
              <text x="123" y="157" class="lbl">NICHE PLAYERS</text>
              <text x="301" y="157" class="lbl">VISIONARIES</text>
              <text x="212" y="222" class="axis">{TEXT.mqAxisX} →</text>
              <text x="20" y="105" class="axis" transform="rotate(-90 20 105)">{TEXT.mqAxisY} →</text>
            </svg>
            <h2>{q.market} <small>{q.year}</small></h2>
            <ul>
              {q.tools.map((t) => (
                <li><a href={`${atlas}?q=${encodeURIComponent(t.name)}`}>{t.name}</a> <span>{t.vendor}</span></li>
              ))}
            </ul>
            <p class="atlas-mq-foot">
              <span>{nf.format(q.tools.length)} {TEXT.tools}</span>
              {q.url && <a href={q.url} target="_blank" rel="noopener">{TEXT.mqReport} ↗</a>}
            </p>
          </article>
        ))}
      </div>
      <p class="atlas-note">{TEXT.mqNote}</p>
      <p><a class="atlas-back" href={atlas}>← {TEXT.backToAtlas}</a></p>
    </section>
  </div>
</Base>

<style is:global>
  .atlas-page { max-width: 1400px; }
  .atlas-guide-title { margin: 0 0 8px; font-size: 30px; }
  .atlas-mq-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; margin-top: 20px; }
  @media (max-width: 760px) { .atlas-mq-grid { grid-template-columns: 1fr; } }
  .atlas-mq-block { border: 1px solid var(--line); border-radius: 6px; padding: 16px 18px; display: flex; flex-direction: column; }
  .atlas-mq-pic { display: block; width: 100%; max-width: 340px; height: auto; margin: 0 auto 12px; }
  .atlas-mq-pic .frame { fill: none; stroke: #9aa5a0; stroke-width: 1.5; }
  .atlas-mq-pic .q { stroke: #fff; stroke-width: 2; }
  .atlas-mq-pic .q1, .atlas-mq-pic .q4 { fill: #eef3f0; }
  .atlas-mq-pic .q2 { fill: #dcebe2; }
  .atlas-mq-pic .q3 { fill: #f6f8f7; }
  .atlas-mq-pic .lbl { font: 600 13px system-ui, sans-serif; fill: #5b6b63; text-anchor: middle; letter-spacing: .06em; }
  .atlas-mq-pic .axis { font: 12px system-ui, sans-serif; fill: #7a8580; text-anchor: middle; }
  .atlas-mq-block h2 { margin: 0 0 10px; font-size: 18px; line-height: 1.3; }
  .atlas-mq-block h2 small { font-weight: 400; color: var(--muted); font-size: 14px; margin-left: 4px; }
  .atlas-mq-block ul { list-style: none; margin: 0; padding: 0; font-size: 14px; line-height: 1.45; columns: 2; column-gap: 18px; flex: 1; }
  @media (max-width: 1000px) { .atlas-mq-block ul { columns: 1; } }
  .atlas-mq-block li { padding: 5px 0; border-top: 1px solid var(--line); break-inside: avoid; }
  .atlas-mq-block li a { font-weight: 600; }
  .atlas-mq-block li span { display: block; color: var(--muted); font-size: 13px; }
  .atlas-mq-foot { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin: 12px 0 0; font-size: 13px; color: var(--muted); }
  .atlas-mq-foot a { font-weight: 600; }
  .atlas-note { margin-top: 30px; font-size: 13px; color: var(--muted); line-height: 1.6; }
  .atlas-back { font-weight: 600; }
</style>
