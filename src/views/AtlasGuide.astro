---
// Category guide of the IT4IT Atlas (/it4it-atlas/categories/ and its translations): every section, group and
// subcategory with its description and number of tools; each subcategory links to the filtered Atlas.
import TAXONOMY from '../data/atlas-taxonomy.json';
import META from '../data/atlas-meta.json';
import Base from '../layouts/Base.astro';
import { locale, url, langOf } from '../i18n';
import { ATLAS_TEXT } from '../data/atlas-text';

const lang = langOf(Astro.url.pathname);
const TEXT = ATLAS_TEXT[lang];
const nf = new Intl.NumberFormat(locale[lang]);
const counts = META.counts as Record<string, number>;
const views = META.views as Record<string, number>;
---
<Base title={`${TEXT.guide} · IT4IT Atlas`} pageTitle={TEXT.guide} crumbs={[{ label: 'IT4IT Atlas', href: url(lang, '/it4it-atlas/') }, { label: TEXT.guide }]}>
  <div class="wrap page-body atlas-page">
    <section class="atlas-guide">
      <h1 class="atlas-guide-title">IT4IT Atlas · {TEXT.guide}</h1>
      <p>{TEXT.guideIntro}</p>
      {TAXONOMY.sections.map((s, i) => (
        <div class="atlas-guide-section">
          <h3><span>{String(i + 1).padStart(2, '0')}</span> {s.name} <small>{nf.format(views[s.id] ?? 0)} {TEXT.tools}</small></h3>
          <p class="muted">{s.intro}</p>
          <div class="atlas-guide-groups">
            {s.groups.map((g) => (
              <div class="atlas-guide-group">
                <h4>{g.name}</h4>
                <ul>
                  {g.subs.map((x) => (
                    <li>
                      <a href={url(lang, `/it4it-atlas/?view=${s.id}&sub=${x.id}`)}>{x.name}</a> <small>({counts[x.id] ?? 0})</small>
                      <div>{x.desc}</div>
                      {x.streams && <div class="muted" title={TEXT.streamsLabel}>{TEXT.streamsLabel}: {x.streams}</div>}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      ))}
      <p class="atlas-note">{TEXT.note}</p>
      <p><a class="atlas-back" href={url(lang, '/it4it-atlas/')}>← {TEXT.backToAtlas}</a></p>
    </section>
  </div>
</Base>

<style is:global>
  .atlas-page { max-width: 1400px; }
  .atlas-guide-title { margin: 0 0 8px; font-size: 30px; }
  .atlas-guide h3:first-of-type { margin-top: 10px; }
  .atlas-guide h3 { margin: 30px 0 4px; }
  .atlas-guide h3 span { color: var(--accent); margin-right: 6px; }
  .atlas-guide h3 small { font-weight: 400; color: var(--muted); font-size: 14px; margin-left: 6px; }
  .atlas-guide-groups { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 18px; margin-top: 14px; }
  .atlas-guide-group { border: 1px solid var(--line); border-radius: 6px; padding: 16px 18px; }
  .atlas-guide-group h4 { margin: 0 0 8px; font-size: 16px; }
  .atlas-guide-group ul { list-style: none; margin: 0; padding: 0; font-size: 14px; line-height: 1.5; }
  .atlas-guide-group li { padding: 8px 0; border-top: 1px solid var(--line); }
  .atlas-guide-group li:first-child { border-top: 0; padding-top: 0; }
  .atlas-guide-group li a { font-weight: 600; }
  .atlas-guide-group li small, .atlas-guide .muted { color: var(--muted); }
  .atlas-guide-group li .muted { font-size: 12px; }
  .atlas-note { margin-top: 30px; font-size: 13px; color: var(--muted); line-height: 1.6; }
  .atlas-back { font-weight: 600; }
</style>
