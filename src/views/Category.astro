---
import ArticleList from '../components/ArticleList.astro';
import { langOf, url, t, categoryName } from '../i18n';
const lang = langOf(Astro.url.pathname);
const T = t(lang);
const { page, name } = Astro.props;
const label = categoryName(name, lang);
---
<ArticleList title={`${T.category}: ${label}`} crumbs={[{ label: T.articles, href: url(lang, '/articles/') }, { label }]} page={page} base={url(lang, `/category/${Astro.params.cat}/`)} />
