---
import Base from '../layouts/Base.astro';
import { langOf } from '../i18n';
// Texts of the form; the script below reads the messages from the form's data attributes.
const T = {
  nl: { title: 'Contact', intro: 'Vertel me wat je nodig hebt, stel je vraag of zeg gewoon hallo.', name: 'Naam', email: 'E-mail', phone: 'Telefoon', message: 'Bericht', hp: 'Laat dit veld leeg', submit: 'Verstuur bericht', sending: 'Bezig met versturen…', failed: 'Versturen is mislukt. Probeer het later opnieuw of mail naar Info@JAVC.nl.', thanks: 'Dank je wel! Je bericht is verstuurd. Ik neem snel contact met je op.', country: 'Nederland', phoneL: 'Telefoon', kvk: 'KvK-nr.', vat: 'Btw-nr.' },
  en: { title: 'Contact me', intro: 'Tell me about your needs, ask your question or just say hello.', name: 'Name', email: 'Email', phone: 'Phone', message: 'Message', hp: 'Leave this field empty', submit: 'Submit message', sending: 'Sending…', failed: 'Sending failed. Please try again later or email Info@JAVC.nl.', thanks: 'Thank you! Your message has been sent. I will get back to you soon.', country: 'The Netherlands', phoneL: 'Phone', kvk: 'KvK No.', vat: 'V.A.T. No.' },
  zh: { title: '联系我', intro: '告诉我您的需求，提出您的问题，或者只是打个招呼。', name: '姓名', email: '电子邮件', phone: '电话', message: '留言', hp: '请勿填写此栏', submit: '发送留言', sending: '正在发送…', failed: '发送失败。请稍后再试，或发送电子邮件至 Info@JAVC.nl。', thanks: '谢谢！您的留言已发送，我会尽快与您联系。', country: '荷兰', phoneL: '电话', kvk: '商会注册号 (KvK)', vat: '增值税号' },
}[langOf(Astro.url.pathname)];
---
<Base title={T.title} pageTitle={T.title} crumbs={[{ label: T.title }]}>
  <div class="wrap contact">
    <div>
      <p class="intro">{T.intro}</p>
      <form class="contact-form" id="contact" data-submit={T.submit} data-sending={T.sending} data-failed={T.failed} data-thanks={T.thanks}>
        <label>{T.name} *<input name="name" required /></label>
        <label>{T.email} *<input name="email" type="email" required /></label>
        <label>{T.phone} *<input name="phone" type="tel" required /></label>
        <label>{T.message} *<textarea name="message" rows="6" required></textarea></label>
        <label class="hp" aria-hidden="true">{T.hp}<input name="hp_note" tabindex="-1" autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore /></label>
        <button class="btn" type="submit">{T.submit}</button>
        <p class="notice" role="status" hidden></p>
      </form>
    </div>
    <div class="contact-details">
      <h3>JAVC Management &amp; Consultancy</h3>
      <p>Att. Jeroen A. van Craaikamp<br />Randwijcklaan 1<br />1181 BL Amstelveen<br />{T.country}</p>
      <p>{T.phoneL}: <a href="tel:+31643583097">+31-6-43583097</a><br />Email: <a href="mailto:info@javc.nl">Info@JAVC.nl</a></p>
      <p class="muted">{T.kvk}: 87947064<br />{T.vat}: NL004522154B44<br />IBAN: NL48KNAB0513732187 (BIC KNABNL2H)</p>
    </div>
  </div>
  <script>
    import { protect } from '../scripts/botcheck';
    const form = document.getElementById('contact') as HTMLFormElement;
    const bot = protect(form);
    const notice = form.querySelector('.notice') as HTMLElement;
    const button = form.querySelector('button[type=submit]') as HTMLButtonElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      button.disabled = true;
      button.textContent = form.dataset.sending!;
      notice.hidden = true;
      let ok = false, msg = form.dataset.failed!;
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ ...Object.fromEntries(new FormData(form)), ...bot.extra(), lang: document.documentElement.lang.slice(0, 2) }),
        });
        const data = await res.json().catch(() => ({}));
        ok = res.ok && data.ok;
        if (data.error) msg = data.error;
      } catch {}
      notice.className = `notice ${ok ? 'ok' : 'error'}`;
      notice.textContent = ok ? form.dataset.thanks! : msg;
      notice.hidden = false;
      if (ok) form.reset();
      bot.reset();
      button.disabled = false;
      button.textContent = form.dataset.submit!;
    });
  </script>
</Base>
