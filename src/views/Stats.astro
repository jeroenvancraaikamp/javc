---
// Private statistics pages (/stats/, /stats/changes/, /stats/contacts/, /stats/subscribers/ and their translations under
// /nl/, /cn/, /fr/, /de/), in the Statistics menu. The content comes from /api/stats?part=… (worker/stats.js),
// which only answers for the owner of the repository, signed in to the CMS in this browser,
// and renders them in the language of the page.
import Base from '../layouts/Base.astro';
import { langOf, url } from '../i18n';
import { STATS_MENU, STATS_PARTS } from '../data/stats-text';

interface Props { part?: 'site' | 'changes' | 'contacts' | 'subscribers' }
const { part = 'site' } = Astro.props;

const lang = langOf(Astro.url.pathname);
const TEXT = {
  en: { title: 'Statistics', loading: 'Loading…', login: '<section><p>This page is only visible when you are signed in to the CMS.</p><p><a href="/cms/">Sign in to the CMS</a>, then open this page again.</p></section>', error: '<section><p>The statistics are not available right now. Please try again later.</p></section>' },
  nl: { title: 'Statistieken', loading: 'Laden…', login: '<section><p>Deze pagina is alleen zichtbaar als je bent ingelogd in het CMS.</p><p><a href="/cms/">Log in op het CMS</a> en open deze pagina daarna opnieuw.</p></section>', error: '<section><p>De statistieken zijn nu niet beschikbaar. Probeer het later nog eens.</p></section>' },
  cn: { title: '统计', loading: '加载中…', login: '<section><p>只有登录 CMS 后才能查看此页面。</p><p><a href="/cms/">登录 CMS</a>，然后重新打开此页面。</p></section>', error: '<section><p>统计数据暂时不可用，请稍后再试。</p></section>' },
  fr: { title: 'Statistiques', loading: 'Chargement…', login: '<section><p>Cette page n’est visible que si vous êtes connecté au CMS.</p><p><a href="/cms/">Connectez-vous au CMS</a>, puis rouvrez cette page.</p></section>', error: '<section><p>Les statistiques ne sont pas disponibles pour le moment. Réessayez plus tard.</p></section>' },
  de: { title: 'Statistiken', loading: 'Wird geladen…', login: '<section><p>Diese Seite ist nur sichtbar, wenn Sie im CMS angemeldet sind.</p><p><a href="/cms/">Melden Sie sich im CMS an</a> und öffnen Sie diese Seite dann erneut.</p></section>', error: '<section><p>Die Statistiken sind gerade nicht verfügbar. Bitte versuchen Sie es später noch einmal.</p></section>' },
}[lang];
const M = STATS_MENU[lang];
const title = M[part];
---
<Base title={`${title} · ${M.label}`} pageTitle={title} crumbs={[{ label: M.label, href: url(lang, '/stats/') }, { label: title }]} noindex translated>
  <div class="wrap stats" data-lang={lang} data-part={part} data-login={TEXT.login} data-error={TEXT.error}>
    <nav class="stats-tabs">{STATS_PARTS.map((p) => <a href={url(lang, p.path)} class:list={{ on: p.part === part }}>{M[p.part]}</a>)}</nav>
    <div id="stats-out"><p class="muted">{TEXT.loading}</p></div>
  </div>
  <script>
    (async () => {
      const out = document.getElementById('stats-out')!;
      const box = out.parentElement!.dataset;
      const login = box.login!;
      let token = '';
      try { token = JSON.parse(localStorage.getItem('sveltia-cms.user') || '{}').token || ''; } catch {}
      if (!token) { out.innerHTML = login; return; }
      const q = new URLSearchParams(location.search);
      q.set('lang', box.lang!);
      q.set('part', box.part!);
      const res = await fetch('/api/stats?' + q, { headers: { authorization: 'Bearer ' + token } }).catch(() => null);
      if (res && res.ok) {
        out.innerHTML = await res.text();
        // Subscribers page: the Excel export of the list (the data comes along as JSON).
        const data = document.getElementById('subs-data');
        document.getElementById('subs-export')?.addEventListener('click', async () => {
          const { xlsx } = await import('../scripts/xlsx');
          const { sheet, rows } = JSON.parse(data!.textContent || '{}');
          const blob = new Blob([xlsx(sheet, rows, [28, 34, 14, 18, 16, 16, 16, 10, 20, 40])], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
          const a = document.createElement('a');
          a.href = URL.createObjectURL(blob);
          a.download = `IT4IT-Atlas-subscribers-${new Date().toISOString().slice(0, 10)}.xlsx`;
          a.click();
          setTimeout(() => URL.revokeObjectURL(a.href), 1000);
        });
      }
      else if (res && res.status === 401) out.innerHTML = login;
      else out.innerHTML = box.error!;
    })();
  </script>
</Base>

<style is:global>
  .stats-links { margin: 0 0 12px; }
  .stats-tabs { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 22px; }
  .stats-tabs a { padding: 6px 14px; border: 1px solid var(--line); border-radius: 4px; color: var(--text); font-weight: 600; font-size: 14px; }
  .stats-tabs a.on { background: var(--accent); border-color: var(--accent); color: #fff; }
  .stats .contact-list article { border-bottom: 1px solid var(--line); padding: 12px 0; }
  .stats .contact-list article p { margin: 6px 0 0; white-space: normal; }
  .stats .contact-list .meta { font-size: 15px; }
  .stats .btn:disabled { opacity: .5; cursor: default; }
  .stats { --b0: var(--accent); --b1: #a9cfc6; --b2: #e0a458; --b3: #6b8fb5; --b4: #c96f6f; --b5: #a8a69c; padding-top: 30px; padding-bottom: 50px; }
  .stats h2 { margin: 0 0 12px; font-size: 22px; }
  .stats h3 { font-size: 15px; margin: 18px 0 8px; }
  .stats h3 small { font-weight: 400; color: var(--muted); margin-left: 8px; }
  .stats .k { display: inline-block; width: 10px; height: 10px; margin: 0 4px 0 10px; border-radius: 2px; }
  .stats .ranges { display: flex; gap: 6px; flex-wrap: wrap; margin: 0 0 20px; }
  .stats .ranges a { padding: 4px 14px; border-radius: 999px; border: 1px solid var(--line); color: var(--text); }
  .stats .ranges a.on { background: var(--accent); border-color: var(--accent); color: #fff; }
  .stats section { border: 1px solid var(--line); border-radius: 6px; padding: 20px; margin-bottom: 24px; }
  .stats .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px; }
  .stats .tile { border: 1px solid var(--line); border-radius: 6px; padding: 10px 12px; }
  .stats .tile .v { font-size: 22px; font-weight: 700; line-height: 1.4; }
  .stats .tile .l { color: var(--muted); font-size: 13px; }
  .stats .grid { display: grid; grid-template-columns: 3fr 2fr; gap: 24px; }
  @media (max-width: 760px) { .stats .grid { grid-template-columns: 1fr; } }
  .stats table { width: 100%; border-collapse: collapse; font-size: 14px; line-height: 1.5; }
  .stats th, .stats td { text-align: left; padding: 5px 6px; border-bottom: 1px solid var(--line); vertical-align: top; overflow-wrap: anywhere; }
  .stats th { color: var(--muted); font-weight: 600; }
  .stats .n { text-align: right; white-space: nowrap; }
  .stats .nw { white-space: nowrap; }
  .stats .cd tr:not(.c) td { border-bottom: 0; padding-bottom: 0; font-weight: 600; }
  .stats .cd tr.c td { font-size: 13px; }
  .stats .bars { display: flex; align-items: flex-end; gap: 2px; height: 120px; border-bottom: 1px solid var(--line); }
  .stats .bar { flex: 1; height: 100%; display: flex; align-items: flex-end; gap: 1px; }
  .stats .bar span { flex: 1; min-height: 1px; border-radius: 2px 2px 0 0; }
  .stats .b0 { background: var(--b0); }
  .stats .b1 { background: var(--b1); }
  .stats .b2 { background: var(--b2); }
  .stats .b3 { background: var(--b3); }
  .stats .b4 { background: var(--b4); }
  .stats .b5 { background: var(--b5); }
  .stats .bars.stacked .bar { flex-direction: column-reverse; justify-content: flex-start; align-items: stretch; gap: 1px; }
  .stats .bars.stacked .bar span { flex: none; min-height: 0; border-radius: 0; }
  .stats .bars.stacked .bar span:last-child { border-radius: 2px 2px 0 0; }
  .stats .axis { display: flex; justify-content: space-between; color: var(--muted); font-size: 12px; }
  .stats .err { color: #d63638; font-size: 12px; }
  .stats .tag { font-size: 11px; padding: 1px 6px; border-radius: 4px; background: var(--line); }
</style>
