// Cloudflare Worker "javc": the static site from dist/ plus the chatbot at /api/chat.
// Workers Builds runs `npm run build` and then `npx wrangler deploy` on every push to main.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "javc",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/"]
  },
  // javc.nl and www.javc.nl point to this Worker (www is redirected to javc.nl in worker/index.js)
  "routes": [
    { "pattern": "javc.nl", "custom_domain": true },
    { "pattern": "www.javc.nl", "custom_domain": true }
  ],
  "ai": { "binding": "AI" },
  // Every 15 minutes from 05:00 to 23:45 UTC: from 07:30 Amsterdam time, e-mail the day's IT4IT Atlas report to Jeroen and the subscribers once it is live (worker/atlas-subscribers.js).
  "triggers": { "crons": ["*/15 5-23 * * *"] },
  // Statistics database (page views + chatbot questions, see worker/stats.js) and the IT4IT Atlas subscribers.
  // No database_id: wrangler creates the database "javc-stats" automatically on the first deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "javc-stats" }],
  // Rate limits per visitor IP (per Cloudflare location): chatbot 10/min, contact form and Atlas subscribe form 3/min
  "ratelimits": [
    { "name": "CHAT_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "CONTACT_LIMITER", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }
  ],
  // Contact form (secret SMTP2GO_API_KEY is set in the Cloudflare dashboard, not here)
  "vars": {
    "CONTACT_TO": "Info@JAVC.nl",
    "CONTACT_FROM": "JAVC website <info@javc.nl>"
  },
  // Keep variables added in the Cloudflare dashboard when deploying (e.g. STATS_PASSWORD added as Text instead of Secret).
  "keep_vars": true,
  "observability": { "enabled": true }
}
