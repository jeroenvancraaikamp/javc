// Cloudflare Worker "javc": the static site from dist/ plus the chatbot at /api/chat.
// Workers Builds runs `npm run build` and then `npx wrangler deploy` on every push to main.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "javc",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/"]
  },
  // javc.nl and www.javc.nl point to this Worker (www is redirected to javc.nl in worker/index.js)
  "routes": [
    { "pattern": "javc.nl", "custom_domain": true },
    { "pattern": "www.javc.nl", "custom_domain": true }
  ],
  "ai": { "binding": "AI" },
  // Rate limits per visitor IP (per Cloudflare location): chatbot 10/min, contact form 3/min
  "ratelimits": [
    { "name": "CHAT_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "CONTACT_LIMITER", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }
  ],
  // Contact form (secret SMTP2GO_API_KEY is set in the Cloudflare dashboard, not here)
  "vars": {
    "CONTACT_TO": "Info@JAVC.nl",
    "CONTACT_FROM": "JAVC website <info@javc.nl>"
  },
  "observability": { "enabled": true }
}
