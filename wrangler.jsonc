// Cloudflare Worker "javc": the static site from dist/ plus the chatbot at /api/chat.
// Workers Builds runs `npm run build` and then `npx wrangler deploy` on every push to main.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "javc",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
